# Nyumbani Concierge — server configuration
# Copy this file to .env and fill in your real values. Never commit .env.

PORT=3000

# --- Tuma payment gateway (api.tuma.co.ke) — handles M-Pesa STK Push ---
TUMA_BASE_URL=https://api.tuma.co.ke
TUMA_EMAIL=YOUR_TUMA_EMAIL
TUMA_API_KEY=YOUR_TUMA_API_KEY

# Public URL Tuma can reach. Use your deployed URL, or ngrok in development:
#   ngrok http 3000   ->   TUMA_CALLBACK_URL=https://xxxx.ngrok.io/api/callback
# On Render: https://<your-service-name>.onrender.com/api/callback
TUMA_CALLBACK_URL=https://YOUR_APP_URL/api/callback

# --- Supabase (persistent database) ---
# Project Settings -> API: Project URL and the service_role secret key.
# Run db-schema.sql once in the Supabase SQL editor before starting the server.
# If these are empty the server falls back to local JSON files (dev only —
# data is lost on Render restarts, so always set these in production).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Owner admin passcode ---
# Used by the hidden admin dashboard (never linked from the public site).
# Change this to something only you know. There is no default — without it
# admin APIs are locked.
ADMIN_PASSCODE=YOUR_ADMIN_PASSCODE

# Optional: comma-separated list of allowed frontend origins (Vercel URL + localhost).
# Empty = allow any origin (fine while the API uses token auth, not cookies).