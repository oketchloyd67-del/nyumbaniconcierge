[TEMPLATE]
# Nyumbani Concierge — server configuration
# Copy to .env and fill in your real values (see .env for the working setup
# copied from the semacheck project).

PORT=3000

# --- Tuma payment gateway (api.tuma.co.ke) — handles M-Pesa STK Push ---
TUMA_BASE_URL=https://api.tuma.co.ke
TUMA_EMAIL=YOUR_TUMA_EMAIL
TUMA_API_KEY=YOUR_TUMA_API_KEY

# Public URL Tuma can reach. Use your deployed URL, or ngrok in development:
#   ngrok http 3000   ->   TUMA_CALLBACK_URL=https://xxxx.ngrok.io/api/callback
# On Render: https://<your-service-name>.onrender.com/api/callback
TUMA_CALLBACK_URL=https://YOUR_APP_URL/api/callback

# Optional: comma-separated list of allowed frontend origins (Vercel URL + localhost).
# Empty = allow any origin (fine while the API uses token auth, not cookies).
# CORS_ORIGINS=https://nyumbani-concierge.vercel.app,http://localhost:3000